# Copia a .env.local y completa en tu máquina (git ignora .env.local).

PLAYWRIGHT_ENV=qa

# Contraseña compartida Firebase QA (misma para todos los SMOKE_* si usás provisioning)
REGISTRO_SUITE_PASSWORD=

VERCEL_QA_PASSWORD=
VERCEL_AUTOMATION_BYPASS_SECRET=

# Correos: definí uno por rol (Gmail separados o alias Proton +N vía provisioningUsers defaults)
# Familia Free
SMOKE_PARENT_EMAIL=
SMOKE_PARENT_PASSWORD=
SMOKE_PARENT_PLAN=free_capped

# Coordinador escuela (contacto del acuerdo en /admin/licenses)
SMOKE_COORDINATOR_EMAIL=
SMOKE_COORDINATOR_PASSWORD=

# Familia con licencia escolar
SMOKE_SCHOOL_EMAIL=
SMOKE_SCHOOL_PASSWORD=

# Familia Premium
SMOKE_PREMIUM_EMAIL=
SMOKE_PREMIUM_PASSWORD=

# Admin plataforma (debe estar en ADMIN_EMAILS del backend QA)
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=

# Premium SINPE en 06-familia-premium (activación admin; pon 0 para omitir el paso admin)
REGISTRO_PREMIUM_ADMIN_ACTIVATE=1
SMOKE_SCHOOL_NAME=Colegio QA
# Por defecto cada corrida usa «{REGISTRO_SCHOOL_NAME|SMOKE_SCHOOL_NAME} {timestamp ISO}» (mismo correo coordinador OK).
# REGISTRO_ESCUELA_FIXED_SCHOOL=1 → nombre fijo sin timestamp (solo si limpiás datos en QA).
# REGISTRO_ESCUELA_REUSE_CACHED_SCHOOL=1 → reutilizar .cache/school-provisioning-name.txt (solo si reanudás la misma corrida).
REGISTRO_SCHOOL_NAME_SUFFIX=

REGISTRO_SCHOOL_INVITE_CODE=
# Opcional: nombre del niño si el dashboard no lo leyó en el test de canje
REGISTRO_CHILD_GIVEN_NAME=
