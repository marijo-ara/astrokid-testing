{
  "name": "astrokid-web-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Black-box Playwright suite for the AstroKid web app",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test specs/07-smoke",
    "test:e2e": "playwright test specs/11-e2e",
    "test:privacy": "playwright test specs/19-privacy",
    "test:accessibility": "playwright test specs/21-accessibility",
    "test:performance": "playwright test specs/23-performance",
    "test:provisioning": "cross-env PLAYWRIGHT_WORKERS=1 playwright test specs/01-provisioning --grep @provisioning",
    "test:provisioning:chrome": "playwright test specs/01-provisioning --grep @provisioning --project=chrome",
    "test:provisioning:firebase-audit": "playwright test specs/01-provisioning/01-firebase-key-smoke.spec.ts",
    "test:all-browsers": "cross-env PLAYWRIGHT_BROWSERS=all playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "test:env-local": "node --experimental-strip-types --test config/load-env-local.test.mjs",
    "test:provisioning-messages": "node --experimental-strip-types --test config/provisioningAuthMessages.test.mjs",
    "test:school-agreement-rules": "node --experimental-strip-types --test config/schoolAgreementRules.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.0"
  }
}
