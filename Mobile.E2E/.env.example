# Copia a .env.local en esta carpeta (git ignora .env.local).
# Una variable ya definida en la terminal gana sobre este archivo.

# Obligatorio para test:apk / test:smoke
ASTROKID_APK=
ASTROKID_BASE_URL=https://astro-kid-backend-1.onrender.com

# QA: bearer del padre (sin esto solo sirve backend local con /auth/dev-login)
ASTROKID_PARENT_TOKEN=
# Solo si el JWT no trae email
ASTROKID_PARENT_EMAIL=

# Bridge con Web.E2E (09-child-qr-download → .cache/child-qr/latest.png)
ASTROKID_USE_WEB_QR=0
# ASTROKID_QR_PNG=C:\ruta\absoluta\astrokid-qr.png

# Opcional Appium / emulador
# ANDROID_DEVICE_NAME=emulator-5554
# ANDROID_PLATFORM_VERSION=14
# APPIUM_SERVER_HOST=127.0.0.1
# APPIUM_SERVER_PORT=4723
